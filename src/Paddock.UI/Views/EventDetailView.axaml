<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paddock.UI.ViewModels"
             xmlns:models="using:Paddock.Core.Models"
             x:Class="Paddock.UI.Views.EventDetailView"
             x:DataType="vm:EventDetailViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Top Header Panel -->
        <Border Grid.Row="0" Background="#16181C" BorderBrush="#2E323B" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid ColumnDefinitions="*,Auto">
                
                <!-- Event Info -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Evento.NomeEvento}" FontSize="22" FontWeight="Bold" Foreground="#EDEDED"/>
                        <Border Background="#22252B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Evento.DateRangeDisplay}" FontSize="11" Foreground="#9EA3AE"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16"
                                IsVisible="{Binding Evento.Luogo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Evento.Luogo, StringFormat='Luogo: {0}'}" FontSize="12" Foreground="#9EA3AE"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4,0,0">
                        <TextBlock FontSize="12" Foreground="#FF8C32" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Atleti: {0}">
                                    <Binding Path="Evento.TotaleAtleti" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#00B4D8" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Discipline: {0}">
                                    <Binding Path="Evento.TotaleDiscipline" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#2ECC71" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Foto: {0}">
                                    <Binding Path="Evento.TotaleFoto" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding Evento.TotaleByteOccupati, Converter={StaticResource ByteToSizeConverter}, StringFormat='Spazio: {0}'}"
                                   FontSize="12" Foreground="#EDEDED" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="primary" Content="Nuova Ingestione SD" Command="{Binding StartIngestionCommand}"/>
                    <Button Classes="secondary" Content="Modifica" Command="{Binding EditEventCommand}"/>
                    <Button Classes="danger" Content="Elimina Evento" Command="{Binding DeleteEventCommand}"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="16,12">
            
            <!-- TAB 1: ATLETI -->
            <TabItem Header="Atleti">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">

                    <!-- Form rapido aggiunta Atleta -->
                    <Border Grid.Row="0" Background="#1A1C20" CornerRadius="6" Padding="14" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="100,*,*,*,Auto" VerticalAlignment="Center">
                            <TextBox Grid.Column="0" Text="{Binding NewPettorale}" PlaceholderText="Pettorale #" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewNome}" PlaceholderText="Nome" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="2" Text="{Binding NewCognome}" PlaceholderText="Cognome" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewCategoria}" PlaceholderText="Categoria (es. Elite, M40)" Margin="0,0,8,0"/>
                            <Button Grid.Column="4" Classes="primary" Content="+ Aggiungi Atleta" Command="{Binding AddAtletaCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Ricerca Atleti -->
                    <TextBox Grid.Row="1" Text="{Binding AthleteSearchFilter}" PlaceholderText="Cerca atleta per pettorale o nome..."
                             Margin="0,0,0,12"/>

                    <!-- Lista Atleti -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding FilteredAtleti}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:Atleta">
                                    <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1"
                                            CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="60,*,*,Auto">
                                            <Border Grid.Column="0" Background="#FF8C32" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding NumeroPettorale, StringFormat='#{0}'}" FontWeight="Bold" Foreground="#121316"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding NomeCompleto}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Categoria}" Foreground="#9EA3AE" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Classes="danger" Content="Rimuovi" Padding="8,3" FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).DeleteAtletaCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- TAB 2: DISCIPLINE -->
            <TabItem Header="Discipline">
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">

                    <!-- Form rapido nuova disciplina -->
                    <Border Grid.Row="0" Background="#1A1C20" CornerRadius="6" Padding="14" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewNomeDisciplina}" PlaceholderText="Nome Disciplina (es. Slalom, Salto in Alto)" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewDescrizioneDisciplina}" PlaceholderText="Descrizione / Percorso (opzionale)" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Classes="primary" Content="+ Aggiungi Disciplina" Command="{Binding AddDisciplinaCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Lista Discipline -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Discipline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:Disciplina">
                                    <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1"
                                            CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding NomeDisciplina}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Descrizione}" Foreground="#9EA3AE" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Classes="danger" Content="Rimuovi" Padding="8,3" FontSize="11"
                                                    Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).DeleteDisciplinaCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- TAB 3: BROWSER FOTO -->
            <TabItem Header="Browser Foto">
                <TabControl Margin="0,4,0,0">

                    <!-- Sotto-Tab 1: Atleti -->
                    <TabItem Header="Atleti">
                        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">

                    <!-- Barra Filtri & Azioni Foto -->
                    <Border Grid.Row="0" Background="#1A1C20" CornerRadius="6" Padding="12" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Filtro Formato -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Filtro Formato:" VerticalAlignment="Center" FontSize="12" Foreground="#9EA3AE"/>
                                <RadioButton Content="Tutti" IsChecked="{Binding FotoFormatFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='TUTTI'}" GroupName="FmtGroup"/>
                                <RadioButton Content="JPEG" IsChecked="{Binding FotoFormatFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='JPEG'}" GroupName="FmtGroup"/>
                                <RadioButton Content="RAW" IsChecked="{Binding FotoFormatFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='RAW'}" GroupName="FmtGroup"/>
                            </StackPanel>

                            <!-- Filtro Atleta (Nome o Pettorale) -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding PhotoAthleteFilter}"
                                     PlaceholderText="Cerca atleta per nome o pettorale..."
                                     Margin="16,0"
                                     VerticalAlignment="Center"
                                     MaxWidth="340"
                                     HorizontalAlignment="Left"/>

                            <!-- Controlli Espandi / Collassa e Ricarica -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="secondary" Content="Espandi tutto" Command="{Binding ExpandAllPhotoGroupsCommand}"
                                        Padding="10,5" FontSize="11"/>
                                <Button Classes="secondary" Content="Collassa tutto" Command="{Binding CollapseAllPhotoGroupsCommand}"
                                        Padding="10,5" FontSize="11"/>
                                <Button Classes="secondary" Content="Ricarica Foto" Command="{Binding RefreshPhotosCommand}"
                                        Padding="10,5" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sezioni Gerarchiche Espandibili: Atleta -> Disciplina -> Foto -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12">

                            <!-- Messaggio se nessuna foto trovata -->
                            <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="6" Padding="32"
                                    HorizontalAlignment="Stretch"
                                    IsVisible="{Binding AthletePhotoGroups.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="Nessuna foto trovata per i criteri selezionati." FontWeight="SemiBold" FontSize="13" Foreground="#9EA3AE" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Effettua un'ingestione o reimposta il filtro formato per visualizzare le foto." FontSize="11" Foreground="#636773" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Lista Gruppi Atleta (Livello 1) -->
                            <ItemsControl ItemsSource="{Binding AthletePhotoGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PhotoBrowserAthleteGroup">
                                        <Expander IsExpanded="{Binding IsExpanded}"
                                                  Background="#16181C" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="6"
                                                  Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                            
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,4">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <Border Background="#22252B" CornerRadius="4" Padding="8,3"
                                                                IsVisible="{Binding Atleta.NumeroPettorale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Atleta.NumeroPettorale, StringFormat='#{0}'}"
                                                                       FontSize="12" FontWeight="Bold" Foreground="#FF8C32"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold" Foreground="#EDEDED" VerticalAlignment="Center"/>
                                                        <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                                IsVisible="{Binding Atleta.Categoria, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Atleta.Categoria}" FontSize="10" Foreground="#9EA3AE"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#2E323B" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TotalPhotosCount, StringFormat='{}{0} foto'}" FontSize="11" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>

                                            <!-- Sotto-sezioni Discipline (Livello 2) -->
                                            <ItemsControl ItemsSource="{Binding DisciplineGroups}" Margin="8,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:PhotoBrowserDisciplinaGroup">
                                                        <Expander IsExpanded="{Binding IsExpanded}"
                                                                  Background="#121316" BorderBrush="#26282E" BorderThickness="1" CornerRadius="4"
                                                                  Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                                            
                                                            <Expander.Header>
                                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,2">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <Border Background="#1A1C20" CornerRadius="3" Padding="6,2">
                                                                            <TextBlock Text="DISCIPLINA" FontSize="9" FontWeight="Bold" Foreground="#9EA3AE"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding NomeDisciplina}" FontSize="13" FontWeight="SemiBold" Foreground="#EDEDED" VerticalAlignment="Center"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="1" Background="#22252B" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding PhotosCount, StringFormat='{}{0} foto'}" FontSize="10" Foreground="#9EA3AE"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Expander.Header>

                                                            <!-- Griglia Foto Relative (Livello 3) -->
                                                            <ItemsControl ItemsSource="{Binding Photos}" Margin="0,8,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>

                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:PhotoItemViewModel">
                                                                        <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1"
                                                                                CornerRadius="6" Width="220" Margin="0,0,10,10" Padding="8">
                                                                            <Grid RowDefinitions="130,Auto,Auto">
                                                                                
                                                                                <!-- 1. Preview Immagine Miniatura -->
                                                                                <Border Grid.Row="0" Background="#101215" CornerRadius="4" ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <!-- Bitmap Thumbnail -->
                                                                                        <Image Source="{Binding ThumbnailBitmap}"
                                                                                               Stretch="UniformToFill"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>

                                                                                        <!-- Placeholder RAW se non generata -->
                                                                                        <Border Background="#16181C" IsVisible="{Binding ShowRawPlaceholder}">
                                                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                                                                <TextBlock Text="RAW" FontWeight="Bold" FontSize="16" Foreground="#636773" HorizontalAlignment="Center"/>
                                                                                                <TextBlock Text="File Negativo" FontSize="9" Foreground="#636773" HorizontalAlignment="Center"/>
                                                                                            </StackPanel>
                                                                                        </Border>

                                                                                        <!-- Indicatore caricamento -->
                                                                                        <Border Background="#A0101215" IsVisible="{Binding IsLoadingThumbnail}">
                                                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                                                                <ProgressBar IsIndeterminate="True" Width="50" Height="4"/>
                                                                                                <TextBlock Text="Caricamento..." FontSize="9" Foreground="#9EA3AE" HorizontalAlignment="Center"/>
                                                                                            </StackPanel>
                                                                                        </Border>

                                                                                        <!-- Badges sovrapposti (Formato e Watermark) -->
                                                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                                                                Background="{Binding Formato, Converter={StaticResource FormatToBrushConverter}}"
                                                                                                CornerRadius="3" Padding="5,1">
                                                                                            <TextBlock Text="{Binding Formato}" FontSize="8" FontWeight="Bold" Foreground="#121316"/>
                                                                                        </Border>

                                                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                                                                Background="#1B3A4B" CornerRadius="3" Padding="4,1"
                                                                                                IsVisible="{Binding WatermarkApplicato}">
                                                                                            <TextBlock Text="WM" FontSize="8" FontWeight="Bold" Foreground="#00B4D8"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- 2. Metadati File -->
                                                                                <StackPanel Grid.Row="1" Spacing="3" Margin="0,8,0,8">
                                                                                    <TextBlock Text="{Binding NomeFile}" FontWeight="SemiBold" FontSize="11"
                                                                                               Foreground="#EDEDED" TextTrimming="CharacterEllipsis"/>
                                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                                        <TextBlock Grid.Column="0" Text="{Binding DimensioneDisplay}"
                                                                                                   FontSize="10" Foreground="#9EA3AE"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding DataScattoDisplay}"
                                                                                                   FontSize="10" Foreground="#636773"/>
                                                                                    </Grid>
                                                                                </StackPanel>

                                                                                <!-- 3. Pulsanti Azione (Ingrandisci e Elimina) -->
                                                                                <Grid Grid.Row="2" ColumnDefinitions="*,*">
                                                                                    <Button Grid.Column="0" Classes="secondary" Content="Ingrandisci" Margin="0,0,4,0"
                                                                                            Padding="6,4" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                                            Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).OpenPhotoViewerCommand}"
                                                                                            CommandParameter="{Binding}"/>

                                                                                    <Button Grid.Column="1" Classes="danger" Content="Elimina" Margin="4,0,0,0"
                                                                                            Padding="6,4" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                                            Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).DeleteSinglePhotoCommand}"
                                                                                            CommandParameter="{Binding}"/>
                                                                                </Grid>

                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                        </Grid>
                    </TabItem>

                    <!-- Sotto-Tab 2: Premiazioni -->
                    <TabItem Header="Premiazioni">
                        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">

                            <!-- Barra Azioni Premiazioni -->
                            <Border Grid.Row="0" Background="#1A1C20" CornerRadius="6" Padding="12" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="Foto Premiazioni" FontWeight="SemiBold" FontSize="13" Foreground="#EDEDED" VerticalAlignment="Center"/>
                                        <Border Background="#22252B" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PremiazioniPhotos.Count, StringFormat='{}{0} foto'}" FontSize="10" Foreground="#9EA3AE"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1" Classes="secondary" Content="Ricarica Foto" Command="{Binding RefreshPhotosCommand}"
                                            Padding="10,5" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Lista Foto Premiazioni (Nessun filtro, mostra tutte le foto) -->
                            <ScrollViewer Grid.Row="1">
                                <StackPanel Spacing="12">

                                    <!-- Messaggio se nessuna foto trovata -->
                                    <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="6" Padding="32"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{Binding PremiazioniPhotos.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="Nessuna foto delle premiazioni presente." FontWeight="SemiBold" FontSize="13" Foreground="#9EA3AE" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Importa foto selezionando l'opzione Premiazioni nell'ingestione." FontSize="11" Foreground="#636773" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Griglia Foto Premiazioni -->
                                    <ItemsControl ItemsSource="{Binding PremiazioniPhotos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:PhotoItemViewModel">
                                                <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1"
                                                        CornerRadius="6" Width="220" Margin="0,0,10,10" Padding="8">
                                                    <Grid RowDefinitions="130,Auto,Auto">

                                                        <!-- 1. Preview Immagine Miniatura -->
                                                        <Border Grid.Row="0" Background="#101215" CornerRadius="4" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding ThumbnailBitmap}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                                <Border Background="#16181C" IsVisible="{Binding ShowRawPlaceholder}">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                                        <TextBlock Text="RAW" FontWeight="Bold" FontSize="16" Foreground="#636773" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="File Negativo" FontSize="9" Foreground="#636773" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <Border Background="#A0101215" IsVisible="{Binding IsLoadingThumbnail}">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                                        <ProgressBar IsIndeterminate="True" Width="50" Height="4"/>
                                                                        <TextBlock Text="Caricamento..." FontSize="9" Foreground="#9EA3AE" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                                        Background="{Binding Formato, Converter={StaticResource FormatToBrushConverter}}"
                                                                        CornerRadius="3" Padding="5,1">
                                                                    <TextBlock Text="{Binding Formato}" FontSize="8" FontWeight="Bold" Foreground="#121316"/>
                                                                </Border>

                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                                        Background="#1B3A4B" CornerRadius="3" Padding="4,1"
                                                                        IsVisible="{Binding WatermarkApplicato}">
                                                                    <TextBlock Text="WM" FontSize="8" FontWeight="Bold" Foreground="#00B4D8"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 2. Metadati File -->
                                                        <StackPanel Grid.Row="1" Spacing="3" Margin="0,8,0,8">
                                                            <TextBlock Text="{Binding NomeFile}" FontWeight="SemiBold" FontSize="11"
                                                                       Foreground="#EDEDED" TextTrimming="CharacterEllipsis"/>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding DimensioneDisplay}"
                                                                           FontSize="10" Foreground="#9EA3AE"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding DataScattoDisplay}"
                                                                           FontSize="10" Foreground="#636773"/>
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- 3. Pulsanti Azione (Ingrandisci e Elimina) -->
                                                        <Grid Grid.Row="2" ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="secondary" Content="Ingrandisci" Margin="0,0,4,0"
                                                                    Padding="6,4" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                    Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).OpenPremiazioniPhotoViewerCommand}"
                                                                    CommandParameter="{Binding}"/>

                                                            <Button Grid.Column="1" Classes="danger" Content="Elimina" Margin="4,0,0,0"
                                                                    Padding="6,4" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                    Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).DeleteSinglePhotoCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>

                        </Grid>
                    </TabItem>

                </TabControl>
            </TabItem>

            <!-- TAB 4: ACQUISTI E VENDITA FOTO -->
            <TabItem Header="Acquisti">
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">

                    <!-- Form Registrazione Nuovo Acquisto -->
                    <Border Grid.Row="0" Background="#1A1C20" CornerRadius="6" Padding="16" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Registrazione Nuovo Acquisto Foto" FontSize="14" FontWeight="Bold" Foreground="#EDEDED"/>
                                    <TextBlock Text="Associa pacchetti o foto ad un atleta e registra i recapiti per l'invio" FontSize="11" Foreground="#9EA3AE"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Content="Registra Acquisto"
                                        Command="{Binding RegistraAcquistoCommand}" Padding="16,8"/>
                            </Grid>

                            <!-- Griglia a 3 Colonne per Form -->
                            <Grid ColumnDefinitions="*,*,*">

                                <!-- Colonna 1: Dati Acquirente & Atleta -->
                                <Border Grid.Column="0" Background="#16181C" CornerRadius="6" Padding="12" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,8,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="1. Dati Atleta &amp; Contatto" FontWeight="SemiBold" FontSize="11" Foreground="#FF8C32"/>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Atleta Acquirente *" FontSize="11" Foreground="#9EA3AE"/>
                                            <ComboBox ItemsSource="{Binding AllAtleti}"
                                                      SelectedItem="{Binding SelectedAcquistoAtleta}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayPettoraleNome}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Disciplina di Riferimento" FontSize="11" Foreground="#9EA3AE"/>
                                            <ComboBox ItemsSource="{Binding Discipline}"
                                                      SelectedItem="{Binding SelectedAcquistoDisciplina}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding NomeDisciplina}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Email Cliente" FontSize="11" Foreground="#9EA3AE"/>
                                            <TextBox Text="{Binding EmailCliente}" PlaceholderText="cliente@email.com"/>
                                        </StackPanel>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Telefono / WhatsApp" FontSize="11" Foreground="#9EA3AE"/>
                                            <TextBox Text="{Binding TelefonoCliente}" PlaceholderText="+39 333 1234567"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Colonna 2: Selezione Pacchetti e Prezzi -->
                                <Border Grid.Column="1" Background="#16181C" CornerRadius="6" Padding="12" BorderBrush="#2E323B" BorderThickness="1" Margin="4,0,4,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="2. Pacchetti &amp; Totale" FontWeight="SemiBold" FontSize="11" Foreground="#FF8C32"/>

                                        <!-- Aggiunta Voce -->
                                        <Grid ColumnDefinitions="*,60,Auto">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding CatalogoDisponibile}"
                                                      SelectedItem="{Binding SelectedCatalogoItemToAdd}"
                                                      HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Nome, StringFormat='{}{0}'}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBox Grid.Column="1" Text="{Binding QuantitaToAdd}" Margin="0,0,6,0"/>

                                            <Button Grid.Column="2" Classes="secondary" Content="+" Padding="10,6"
                                                    Command="{Binding AddVoceAcquistoCommand}"/>
                                        </Grid>

                                        <!-- Voci nel Carrello -->
                                        <ScrollViewer MaxHeight="110">
                                            <ItemsControl ItemsSource="{Binding VociAcquistoCorrente}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:VoceAcquisto">
                                                        <Border Background="#22252B" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding NomeArticolo}" FontSize="11" Foreground="#EDEDED" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Quantita, StringFormat='x{0}'}" FontSize="11" Foreground="#9EA3AE" Margin="6,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Subtotale, StringFormat='€ {0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="#2ECC71" Margin="6,0"/>
                                                                <Button Grid.Column="3" Classes="danger" Content="Rimuovi" Padding="6,2" FontSize="10"
                                                                        Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).RemoveVoceAcquistoCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Totali -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Totale Listino:" FontSize="10" Foreground="#9EA3AE"/>
                                                <TextBlock Text="{Binding TotaleCalcolato, StringFormat='€ {0:N2}'}" FontSize="12" Foreground="#00B4D8" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Totale Effettivo Pagato (€):" FontSize="10" Foreground="#EDEDED" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding TotalePagato}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Colonna 3: Riferimento Foto Atleta -->
                                <Border Grid.Column="2" Background="#16181C" CornerRadius="6" Padding="12" BorderBrush="#2E323B" BorderThickness="1" Margin="8,0,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="3. Riferimento Foto" FontWeight="SemiBold" FontSize="11" Foreground="#FF8C32"/>

                                        <CheckBox Content="Invia Intera Cartella dell'Atleta"
                                                  IsChecked="{Binding InteraCartella}"
                                                  FontSize="11" Foreground="#EDEDED"/>

                                        <!-- Selezione selettiva foto -->
                                        <StackPanel Spacing="4" IsVisible="{Binding !InteraCartella}">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="Foto caricate atleta:" FontSize="10" Foreground="#9EA3AE" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Classes="secondary" Content="Tutte" FontSize="9" Padding="4,2" Margin="0,0,4,0"
                                                        Command="{Binding SelectAllFotoAtletaCommand}"/>
                                                <Button Grid.Column="2" Classes="secondary" Content="Nessuna" FontSize="9" Padding="4,2"
                                                        Command="{Binding DeselectAllFotoAtletaCommand}"/>
                                            </Grid>

                                            <ScrollViewer MaxHeight="100">
                                                <ItemsControl ItemsSource="{Binding FotoDisponibiliAtleta}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:FotoSelectionItem">
                                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                                                                <TextBlock Text="{Binding Foto.NomeFileOriginale}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Note Ordine:" FontSize="10" Foreground="#9EA3AE"/>
                                            <TextBox Text="{Binding NoteAcquisto}" PlaceholderText="es. Pagato con POS, inviare via WeTransfer" Height="50" AcceptsReturn="True"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </Grid>

                            <!-- Messaggio Feedback Acquisto -->
                            <Border Background="#1F2F20" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="4" Padding="10,6"
                                    IsVisible="{Binding AcquistoStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding AcquistoStatusMessage}" Foreground="#2ECC71" FontSize="11"/>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Storico Ordini Registrati -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="Storico Ordini Registrati per questo Evento"
                                       FontSize="13" FontWeight="Bold" Foreground="#EDEDED" VerticalAlignment="Center"/>

                            <Border Grid.Column="2" Background="#1F2F20" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TotaleIncassatoEvento, StringFormat='Incasso Totale: € {0:N2}'}"
                                           FontWeight="Bold" FontSize="12" Foreground="#2ECC71"/>
                            </Border>

                            <Border Grid.Column="3" Background="#22252B" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="{Binding TotaleOrdiniEvento, StringFormat='Ordini: {0}'}"
                                           FontWeight="SemiBold" FontSize="12" Foreground="#00B4D8"/>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Acquisti}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:AcquistoFoto">
                                        <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1"
                                                CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="110,180,120,*,110,130,Auto">

                                                <!-- Data/Ora -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataAcquisto, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                                    <TextBlock Text="{Binding DataAcquisto, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="#636773"/>
                                                </StackPanel>

                                                <!-- Atleta -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Background="#FF8C32" CornerRadius="3" Padding="4,1">
                                                            <TextBlock Text="{Binding NumeroPettorale, StringFormat='#{0}'}" FontWeight="Bold" FontSize="9" Foreground="#121316"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding NomeAtleta}" FontWeight="SemiBold" FontSize="12" Foreground="#EDEDED" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding NomeDisciplina}" FontSize="10" Foreground="#9EA3AE"/>
                                                </StackPanel>

                                                <!-- Recapiti -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding EmailCliente}" FontSize="10" Foreground="#00B4D8" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TelefonoCliente}" FontSize="10" Foreground="#9EA3AE" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Pacchetti & Voci -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0" Spacing="2">
                                                    <TextBlock Text="{Binding VociSommarioDisplay}" FontSize="11" Foreground="#EDEDED" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RiferimentoFotoDisplay}" FontSize="10" Foreground="#636773"/>
                                                </StackPanel>

                                                <!-- Totale Pagato -->
                                                <TextBlock Grid.Column="4" Text="{Binding TotalePagato, StringFormat='€ {0:N2}'}"
                                                           FontSize="14" FontWeight="Bold" Foreground="#2ECC71"
                                                           VerticalAlignment="Center"/>

                                                <!-- Stato / Cartella -->
                                                <Border Grid.Column="5" Background="#22252B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Stato}" FontSize="10" Foreground="#EDEDED"/>
                                                </Border>

                                                <!-- Elimina -->
                                                <Button Grid.Column="6" Classes="danger" Content="Elimina" Padding="8,3" FontSize="11"
                                                        Command="{Binding $parent[UserControl].((vm:EventDetailViewModel)DataContext).DeleteAcquistoCommand}"
                                                        CommandParameter="{Binding}"/>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- Loading Overlay (Busy Indicator) -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B0121316"
                IsVisible="{Binding IsBusy}"
                ZIndex="999">
            <Border Background="#1A1C20"
                    BorderBrush="#2E323B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 4 20 #40000000">
                <StackPanel Spacing="16" HorizontalAlignment="Center" Width="280">
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="#FF8C32" Background="#2E323B"/>
                    <TextBlock Text="{Binding BusyMessage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#EDEDED"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
