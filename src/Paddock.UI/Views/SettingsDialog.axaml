<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paddock.UI.ViewModels"
             xmlns:models="using:Paddock.Core.Models"
             x:Class="Paddock.UI.Views.SettingsDialog"
             x:DataType="vm:SettingsViewModel"
             Width="740" MaxHeight="800">

    <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border CornerRadius="6" ClipToBounds="True" Width="36" Height="36" Background="#16181C"
                            BorderBrush="#2E323B" BorderThickness="1">
                        <Image Source="/Assets/logo.jpg" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="IMPOSTAZIONI E CATALOGO PREZZI" FontSize="15" FontWeight="Bold" Foreground="#EDEDED" LetterSpacing="0.8"/>
                        <TextBlock Text="Configurazione del database Excel, archivio foto e listino prezzi di vendita" FontSize="11" Foreground="#9EA3AE"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="✕" Padding="8,4" FontSize="12"
                        Command="{Binding CloseCommand}"/>
            </Grid>

            <!-- 2. TabControl Principale -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- TAB 1: DATABASE & ARCHIVIO -->
                <TabItem Header="Database &amp; Archivio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel Spacing="16">

                            <!-- Database Excel Attivo -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="DATABASE EXCEL ATTIVO" FontSize="12" FontWeight="SemiBold" Foreground="#FF8C32" LetterSpacing="0.5"/>

                                <Border Background="#121316" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="File Database Corrente:" FontSize="10" Foreground="#636773" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DatabaseFilePath}" FontSize="12" Foreground="#00B4D8" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Classes="secondary" Content="📂 Apri Database Esistente..." Margin="0,0,6,0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Click="BrowseOpenDatabase_Click"/>
                                    <Button Grid.Column="1" Classes="secondary" Content="➕ Crea Nuovo Database..." Margin="6,0,0,0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Click="BrowseNewDatabase_Click"/>
                                </Grid>

                                <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding RecentDatabases.Count}">
                                    <TextBlock Text="Database Recenti:" FontSize="11" Foreground="#9EA3AE"/>
                                    <ItemsControl ItemsSource="{Binding RecentDatabases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="secondary" HorizontalAlignment="Stretch" Margin="0,2" Padding="8,4"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SwitchDatabaseCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Grid.Column="0" Text="📄 " FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11" Foreground="#EDEDED" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <CheckBox Content="Apri automaticamente l'ultimo database utilizzato all'avvio"
                                          IsChecked="{Binding AutoOpenLastDatabase}"
                                          Command="{Binding ToggleAutoOpenLastDatabaseCommand}"
                                          FontSize="12" Foreground="#9EA3AE" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#2E323B"/>

                            <!-- BasePath Archivio Foto -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="PERCORSO BASE ARCHIVIO FOTO (BASEPATH)" FontSize="12" FontWeight="SemiBold" Foreground="#FF8C32" LetterSpacing="0.5"/>

                                <Border Background="#16181C" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <TextBlock Text="Le foto vengono salvate con percorso relativo ('Evento / Atleta / Disciplina / Formato / File'). Il BasePath definisce la cartella radice su disco."
                                               TextWrapping="Wrap" FontSize="11" Foreground="#9EA3AE" LineHeight="16"/>
                                </Border>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Cartella Radice Archivio Foto:" FontSize="11" Foreground="#EDEDED"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding BasePath}" PlaceholderText="C:\Users\...\Pictures\Paddock"/>
                                        <Button Grid.Column="1" Classes="secondary" Content="📁 Sfoglia..." Margin="8,0,0,0"
                                                Click="BrowseBasePath_Click"/>
                                    </Grid>
                                </StackPanel>

                                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="12,10" Margin="0,4,0,0"
                                        Command="{Binding UpdateBasePathCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Aggiorna BasePath nel Database Excel" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: CATALOGO PREZZI FOTO -->
                <TabItem Header="Catalogo Prezzi Foto">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">

                        <!-- Form Nuovo Articolo Listino -->
                        <Border Grid.Row="0" Background="#16181C" CornerRadius="6" Padding="14" BorderBrush="#2E323B" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Aggiungi Articolo / Pacchetto al Listino Prezzi" FontWeight="SemiBold" FontSize="12" Foreground="#EDEDED"/>

                                <Grid ColumnDefinitions="*,160,100,100">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Nome Articolo *" FontSize="11" Foreground="#9EA3AE"/>
                                        <TextBox Text="{Binding NewItemNome}" PlaceholderText="es. Pacchetto 15 Foto"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Categoria *" FontSize="11" Foreground="#9EA3AE"/>
                                        <ComboBox ItemsSource="{Binding AvailableCategorie}"
                                                  SelectedItem="{Binding NewItemCategoria}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Prezzo (€) *" FontSize="11" Foreground="#9EA3AE"/>
                                        <TextBox Text="{Binding NewItemPrezzo}" PlaceholderText="40.00"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Text="Q.tà Foto" FontSize="11" Foreground="#9EA3AE"/>
                                        <TextBox Text="{Binding NewItemQuantitaFoto}" PlaceholderText="1"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding NewItemDescrizione}"
                                             PlaceholderText="Descrizione dell'articolo (opzionale, es. 15 scatti ad alta risoluzione)"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Classes="primary" Content="+ Aggiungi Articolo"
                                            Command="{Binding AddPrezzoItemCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Barra Azioni Listino -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Listino Prezzi Configurato (memorizzato nel foglio Excel 'ListinoPrezzi')"
                                       FontSize="11" Foreground="#9EA3AE" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="secondary" Content="↺ Ripristina Listino Predefinito"
                                    FontSize="11" Padding="8,4"
                                    Command="{Binding ResetDefaultCatalogoCommand}"/>
                        </Grid>

                        <!-- Elenco Voci Listino -->
                        <ScrollViewer Grid.Row="2" MaxHeight="320">
                            <ItemsControl ItemsSource="{Binding CatalogoPrezzi}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:PrezzoCatalogoItem">
                                        <Border Background="#16181C" BorderBrush="#2E323B" BorderThickness="1"
                                                CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                
                                                <!-- Categoria Badge -->
                                                <Border Grid.Column="0" Background="#22252B" CornerRadius="4" Padding="6,2"
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoriaDisplay}" FontSize="10" Foreground="#FF8C32" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Nome & Descrizione -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                                    <TextBlock Text="{Binding Descrizione}" FontSize="10" Foreground="#9EA3AE"
                                                               IsVisible="{Binding Descrizione, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Quantità Foto Badge -->
                                                <Border Grid.Column="2" Background="#121316" CornerRadius="4" Padding="6,2"
                                                        Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding QuantitaFotoIncluse, StringFormat='Foto: {0}'}"
                                                               FontSize="10" Foreground="#00B4D8"/>
                                                </Border>

                                                <!-- Prezzo -->
                                                <TextBlock Grid.Column="3" Text="{Binding Prezzo, StringFormat='€ {0:N2}'}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#2ECC71"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- Elimina -->
                                                <Button Grid.Column="4" Classes="danger" Content="✕" Padding="6,2" FontSize="11"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeletePrezzoItemCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </TabItem>

                <!-- TAB 3: WATERMARK & METADATI -->
                <TabItem Header="Watermark &amp; Metadati">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel Spacing="16">

                            <!-- Sezione Watermark Predefinito -->
                            <Border Background="#16181C" CornerRadius="6" Padding="14" BorderBrush="#2E323B" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Watermark Predefinito (Applicato ai file JPEG/PNG)" FontWeight="SemiBold" FontSize="13" Foreground="#EDEDED"/>
                                            <TextBlock Text="Abilita il watermark e definisci il logo per le future importazioni" FontSize="11" Foreground="#9EA3AE"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DefaultWatermarkEnabled}" OnContent="Attivo" OffContent="Disattivo"/>
                                    </Grid>

                                    <StackPanel Spacing="10" IsVisible="{Binding DefaultWatermarkEnabled}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="File Immagine Watermark (PNG consigliato):" FontSize="11" Foreground="#9EA3AE"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0" Text="{Binding DefaultWatermarkImagePath}" PlaceholderText="C:\Loghi\WatermarkStudio.png" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Classes="secondary" Content="📁 Sfoglia..." Click="BrowseWatermarkImage_Click"/>
                                            </Grid>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="Posizione Predefinita:" FontSize="11" Foreground="#9EA3AE"/>
                                                <ComboBox ItemsSource="{Binding AvailablePositions}"
                                                          SelectedItem="{Binding DefaultWatermarkPosition}"
                                                          HorizontalAlignment="Stretch"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DefaultWatermarkOpacity, StringFormat='Opacità: {0:P0}'}" FontSize="11" Foreground="#9EA3AE"/>
                                                <Slider Minimum="0.1" Maximum="1.0" Value="{Binding DefaultWatermarkOpacity}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="{Binding DefaultWatermarkScalePercent, StringFormat='Dimensione: {0:P0}'}" FontSize="11" Foreground="#9EA3AE"/>
                                                <Slider Minimum="0.05" Maximum="0.50" Value="{Binding DefaultWatermarkScalePercent}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live Watermark Preview -->
                            <Border Background="#16181C" CornerRadius="6" Padding="14" BorderBrush="#2E323B" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Anteprima Live Posizionamento Watermark" FontWeight="SemiBold" FontSize="12" Foreground="#FF8C32"/>
                                            <TextBlock Text="Campione di riferimento: Canon EOS 600D (5184 x 3456 px, 18.0 MP APS-C, 3:2)" FontSize="10" Foreground="#636773"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#101215" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="6"
                                            Height="180" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding WatermarkPreviewBitmap}" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreviewLoading}"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center" Width="100"/>
                                            <TextBlock Text="Nessun watermark o file immagine non selezionato"
                                                       FontSize="11" Foreground="#636773"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding WatermarkPreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                        </Panel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Metadati Predefiniti Fotografo & Copyright -->
                            <Border Background="#16181C" CornerRadius="6" Padding="14" BorderBrush="#2E323B" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Metadati Autore &amp; Copyright Predefiniti (JPEG + RAW)" FontWeight="SemiBold" FontSize="12" Foreground="#EDEDED"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Nome Fotografo (Artist / Creator):" FontSize="11" Foreground="#9EA3AE"/>
                                            <TextBox Text="{Binding DefaultPhotographerName}" PlaceholderText="es. Mario Rossi"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Avviso Copyright:" FontSize="11" Foreground="#9EA3AE"/>
                                            <TextBox Text="{Binding DefaultCopyrightNotice}" PlaceholderText="es. © 2026 Mario Rossi / Paddock"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Pulsante Salva Impostazioni Watermark & Metadati -->
                            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="12,10" Command="{Binding SaveWatermarkSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Salva Preferenze Watermark &amp; Metadati" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- 3. Feedback Banner & Footer -->
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
                <Border Background="#1F2F20" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="4" Padding="12,8"
                        IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2ECC71" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Height="4" Margin="0,0,16,0"/>
                    <Button Grid.Column="1" Classes="secondary" Content="Chiudi" Padding="20,8"
                            Command="{Binding CloseCommand}"/>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>

