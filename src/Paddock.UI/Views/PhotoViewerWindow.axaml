<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paddock.UI.ViewModels"
        x:Class="Paddock.UI.Views.PhotoViewerWindow"
        x:DataType="vm:PhotoViewerViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/logo.jpg"
        Width="1180" Height="820"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#101215">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#16181C" BorderBrush="#2E323B" BorderThickness="0,0,0,1" Height="48" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Left: Title, Counter & Format Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#FF8C32" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="PADDOCK VISORE" FontSize="10" FontWeight="Bold" Foreground="#121316"/>
                    </Border>

                    <Border Background="#22252B" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding CounterDisplay}" FontSize="12" Foreground="#9EA3AE" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="{Binding NomeFile}" FontSize="13" FontWeight="Bold" Foreground="#EDEDED" VerticalAlignment="Center"/>

                    <Border Background="#2E323B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Formato}" FontSize="9" FontWeight="Bold" Foreground="#EDEDED"/>
                    </Border>

                    <Border Background="#1B3A4B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                            IsVisible="{Binding WatermarkApplicato}">
                        <TextBlock Text="WM" FontSize="9" FontWeight="Bold" Foreground="#00B4D8"/>
                    </Border>
                </StackPanel>

                <!-- Center: Status / Error message -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#E74C3C" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0"/>

                <!-- Right: Navigation hints & Close button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#1A1C20" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="Frecce SX / DX per navigare | ESC per uscire" FontSize="11" Foreground="#636773"/>
                    </Border>
                    <Button Classes="secondary" Content="Chiudi" Command="{Binding CloseViewerCommand}" Padding="12,5" FontSize="11"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Image Area -->
        <Grid Grid.Row="1" Background="#0C0E11">

            <!-- High-Res Image -->
            <Image Source="{Binding CurrentBitmap}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <!-- Loading Indicator -->
            <Border Background="#C0101215" CornerRadius="8" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding IsLoading}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="6"/>
                    <TextBlock Text="Caricamento foto..." Foreground="#EDEDED" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- No Preview Fallback -->
            <Border Background="#C016181C" CornerRadius="8" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding CurrentBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                <StackPanel Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding !IsLoading}">
                    <TextBlock Text="Nessuna anteprima visualizzabile" Foreground="#9EA3AE" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding FullPath}" Foreground="#636773" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Navigation Buttons Overlay (Left & Right) -->
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
                    Classes="secondary" Content="Precedente" Padding="14,10" FontSize="12"
                    Command="{Binding PreviousPhotoCommand}"
                    IsEnabled="{Binding CanGoPrevious}"/>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                    Classes="secondary" Content="Successiva" Padding="14,10" FontSize="12"
                    Command="{Binding NextPhotoCommand}"
                    IsEnabled="{Binding CanGoNext}"/>

        </Grid>

        <!-- Bottom Metadata and Operations Bar -->
        <Border Grid.Row="2" Background="#16181C" BorderBrush="#2E323B" BorderThickness="0,1,0,0" Height="60" Padding="16,0">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Metadata Summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Atleta:" Foreground="#9EA3AE" FontSize="11"/>
                        <TextBlock Text="{Binding AtletaDisplay}" Foreground="#FF8C32" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Disciplina:" Foreground="#9EA3AE" FontSize="11"/>
                        <TextBlock Text="{Binding DisciplinaDisplay}" Foreground="#EDEDED" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Dimensione:" Foreground="#9EA3AE" FontSize="11"/>
                        <TextBlock Text="{Binding DimensioneDisplay}" Foreground="#9EA3AE" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Data Scatto:" Foreground="#9EA3AE" FontSize="11"/>
                        <TextBlock Text="{Binding DataScattoDisplay}" Foreground="#9EA3AE" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="secondary" Content="Apri nella cartella" Command="{Binding OpenFileLocationCommand}"
                            Padding="12,7" FontSize="11"/>
                    <Button Classes="danger" Content="Elimina Foto" Command="{Binding DeleteCurrentPhotoCommand}"
                            IsEnabled="{Binding !IsDeleting}" Padding="12,7" FontSize="11"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>

</Window>

